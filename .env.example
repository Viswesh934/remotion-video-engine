# Remotion Render Settings
# Copy this file to .env and adjust values as needed

# Video quality settings
REMOTION_QUALITY=80
REMOTION_CONCURRENCY=50%

# Output settings
REMOTION_OUTPUT_DIR=./out
REMOTION_OVERWRITE=true

# Performance settings
REMOTION_TIMEOUT=30000
REMOTION_BROWSER_EXECUTABLE=

# Codec settings
REMOTION_CODEC=h264
REMOTION_PIXEL_FORMAT=yuv420p
REMOTION_CRF=18

# Audio settings
REMOTION_AUDIO_CODEC=aac
REMOTION_AUDIO_BITRATE=320k

# Preview settings
REMOTION_STUDIO_PORT=3000
